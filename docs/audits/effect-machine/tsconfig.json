{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": false,
		"types": ["node"]
	},
	"include": ["planner.ts", "planner.test.ts"]
}
