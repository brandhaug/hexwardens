{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		"plugins": [
			{
				"name": "@effect/language-service"
			}
		],
		"typeRoots": ["../node_modules/@types", "../apps/web/node_modules/@types"]
	},
	"include": [
		"./**/*.ts",
		"../alchemy.run.ts",
		"../scripts/alchemy-stage.ts",
		"../scripts/d1-backup.ts",
		"../scripts/check-shared-d1.ts",
		"../.github/scripts/*.ts",
		"../apps/web/src/env.d.ts"
	],
	"extends": "../tsconfig.base.json"
}
