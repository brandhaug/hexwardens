BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Optional: comma-separated extra origins allowed by Better Auth.
BETTER_AUTH_TRUSTED_ORIGINS=
AUTH_JWT_SECRET=
GAME_SERVER_URL=
# Required for `bun run alchemy:deploy`. Comma-separated origins allowed to
# call the game-server (CORS + WebSocket Origin gate). Never use `*` in prod.
# Example: https://hexwardens.gg,https://preview.hexwardens.gg
ALLOWED_ORIGIN=
