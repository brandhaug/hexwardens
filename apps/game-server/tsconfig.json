{
	"extends": "../../tsconfig.base.json",
	"include": ["src/**/*.ts"],
	"compilerOptions": {
		"types": ["@cloudflare/workers-types", "vitest/globals"],
		"plugins": [
			{
				"name": "@effect/language-service",
				"diagnosticSeverity": {
					"preferSchemaOverJson": "off"
				},
				// Effect v4 HTTP and reactive APIs are intentional; retain all other diagnostics.
				"overrides": [
					{
						"include": [
							"src/api-router.ts",
							"src/api.test.ts",
							"src/request-handler.ts",
							"src/handlers/**/*.ts"
						],
						"options": {
							"diagnosticSeverity": {
								"unstableApiUsage": "off"
							}
						}
					}
				]
			}
		]
	}
}
